# ==============================================================================
# YouTube Trend Intelligence Ingestion Pipeline Environment Configuration
# Copy this file to a new file named '.env' and populate with your credentials.
# ==============================================================================

# Application Environment & Log Level
APP_ENV="development"
LOG_LEVEL="INFO"

# Database Configuration
# You must provide either DATABASE_URL or POSTGRES_DB with your Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creatoriq"
POSTGRES_DB="postgresql://postgres:postgres@localhost:5432/creatoriq"

# YouTube Data API v3 Settings
# Replace with a valid Google Cloud Developer Console YouTube API key
Youtube_API_KEY="AIzaSyYourAPIKeyHere..."
YOUTUBE_API_BASE_URL="https://www.googleapis.com/youtube/v3"
YOUTUBE_API_TIMEOUT_SECONDS=30
YOUTUBE_API_MAX_RETRIES=3
YOUTUBE_API_RETRY_BACKOFF_SECONDS=2.0

# Ingestion Pipeline Parameters
LAG_DAYS=3                     # Dynamic publication window lag (Day D runs target videos published on Day D-3)
SEARCH_MAX_RESULTS=40          # Max YouTube search candidates per concept query (capped at 40)
MIN_VIEWS=50                   # Stage 1: Hard filter gate views
MIN_SUBSCRIBERS=100            # Stage 1: Hard filter gate subscribers
MIN_DURATION_SECONDS=60        # Stage 1: Hard filter gate video duration (seconds)
MIN_DESCRIPTION_CHARS=30       # Stage 1: Hard filter gate description length

# Language Verification
LANGUAGE="en"                  # Stage 2: Verified English language code

# Semantic Relevance Filter
EMBEDDING_MODEL="all-MiniLM-L6-v2"  # Stage 3: Local SentenceTransformer embedding model
SEMANTIC_SCORE_THRESHOLD=0.5       # Stage 3: Cosine similarity survival threshold (semantic_score > 0.5)

# Outlier Detection Threshold
OUTLIER_SIGMA=2.0                  # Statistical outlier sigma multiplier (value > mean + outlier_sigma * std)

# Background Daily Cron Ingestion Scheduler
SCHEDULER_HOUR=0               # Scheduled daily trigger hour
SCHEDULER_MINUTE=0             # Scheduled daily trigger minute
SCHEDULER_TIMEZONE="UTC"       # Scheduled daily trigger timezone
